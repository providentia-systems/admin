+
+String _productValue(Record row, String key) {
+  String? text(String field) {
+    final value = row[field];
+    return value is String && value.trim().isNotEmpty ? value : null;
+  }
+
+  return switch (key) {
+    'name' => text('name') ?? text('private_name') ?? 'Unresolved product',
+    'pack_text' => text('pack_text') ?? text('original_pack_text') ?? 'Not specified',
+    'category_name' => text('category_name') ?? 'Unavailable',
+    'private_name' || 'original_pack_text' => text(key) ?? 'No private override',
+    _ => '${row[key] ?? ''}',
+  };
+}
