{
  "schemaVersion": 1,
  "repositoryRole": "linux-admin-client",
  "runtime": {
    "flutter": "3.44.7",
    "dart": "3.12.2"
  },
  "flutterDownload": {
    "linuxX64": {
      "url": "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.44.7-stable.tar.xz",
      "sha256": "a0edd646c159c0e816788c0e46a4f071199c1320495898f5a679599b583a05a4"
    }
  },
  "linux": {
    "aptPackages": [
      "ca-certificates",
      "clang",
      "cmake",
      "curl",
      "git",
      "gzip",
      "jq",
      "libgtk-3-dev",
      "liblzma-dev",
      "libsecret-1-dev",
      "ninja-build",
      "nodejs",
      "pkg-config",
      "ripgrep",
      "unzip",
      "xz-utils",
      "zip"
    ]
  },
  "networkAllowlist": [
    "archive.ubuntu.com",
    "security.ubuntu.com",
    "github.com",
    "api.github.com",
    "objects.githubusercontent.com",
    "codeload.github.com",
    "raw.githubusercontent.com",
    "storage.googleapis.com",
    "pub.dev",
    "api.pub.dev"
  ],
  "runtimeNetwork": [
    "the configured PROVIDENTIA_API_BASE_URL over HTTPS"
  ],
  "coverage": {
    "scope": "all handwritten Dart production libraries under lib/",
    "minimumLineCoveragePercent": 38,
    "targetLineCoveragePercent": 80,
    "policy": ".coverage-policy.json"
  },
  "validation": [
    "bash tool/materialize_contract.sh",
    "bash tools/agent-check.sh"
  ]
}
